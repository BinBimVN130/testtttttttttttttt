flipHBtn.classList.toggle('active', state.flipH);
  const label = document.getElementById('zoom-label');
  if (label) {
    label.textContent = `${state.zoom.toFixed(1)}x`;
    label.style.display = state.zoom > 1 ? 'block' : 'none';
  }
}

// Khởi tạo và Quản lý Camera
async function initCamera() {
  if (state.stream) {
    state.stream.getTracks().forEach(track => track.stop());
  }
  const constraints = {
    video: {
      facingMode: state.facingMode,
      width: { ideal: 1920 },
      height: { ideal: 1080 }
    },
    audio: true
  };

  try {
    state.stream = await navigator.mediaDevices.getUserMedia(constraints);
    video.srcObject = state.stream;
    noCamera.classList.add('hidden');
    setupAudioMeter(state.stream);
  } catch (err) {
    console.error("Không thể kết nối Camera/Microphone:", err);
    noCamera.classList.remove('hidden');
    showToast("Không thể truy cập Camera hoặc Microphone");
  }
}

// Đo mức âm thanh Mic
function setupAudioMeter(stream) {
  try {
    const audioContext = new (window.AudioContext || window.webkitAudioContext)();
    const source = audioContext.createMediaStreamSource(stream);
    const analyser = audioContext.createAnalyser();
    analyser.fftSize = 64;
    source.connect(analyser);
    const dataArray = new Uint8Array(analyser.frequencyBinCount);
    const micBar = document.getElementById('mic-bar');

    function updateMeter() {
      if (state.isRecording) {
        analyser.getByteFrequencyData(dataArray);
        let sum = 0;
        for (let i = 0; i < dataArray.length; i++) sum += dataArray[i];
        let average = sum / dataArray.length;
        let pct = Math.min(100, Math.round((average / 128) * 100));
        if (micBar) micBar.style.width = pct + '%';
      }
      requestAnimationFrame(updateMeter);
    }
    updateMeter();
  } catch (e) {}
}

// Tính FPS
function loopFps() {
  state.frameCount++;
  const now = performance.now();
  if (now - state.lastFpsTime >= 1000) {
    const fps = Math.round((state.frameCount * 1000) / (now - state.lastFpsTime));
    fpsEl.innerHTML = `FPS: ${fps} <span class="ver">| v1.0.0</span>`;
    state.frameCount = 0;
    state.lastFpsTime = now;
  }
  requestAnimationFrame(loopFps);
}
requestAnimationFrame(loopFps);

// Tính toán Tỷ lệ khung hình
function updateAspectRatio() {
  const [wRatio, hRatio] = state.forceAspect.split(':').map(Number);
  const stageW = stage.clientWidth;
  const stageH = stage.clientHeight;
  let targetW = stageW;
  let targetH = stageW * (hRatio / wRatio);

  if (targetH > stageH) {
    targetH = stageH;
    targetW = stageH * (wRatio / hRatio);
  }

  cameraFrame.style.width = `${targetW}px`;
  cameraFrame.style.height = `${targetH}px`;
}
window.addEventListener('resize', updateAspectRatio);

// Chuyển đổi Mode (Photo / Video / QR)
function setMode(mode) {
  if (state.mode === mode) return;
  state.mode = mode;
  cameraFrame.classList.add('mode-switching');
  setTimeout(() => cameraFrame.classList.remove('mode-switching'), 250);

  document.querySelectorAll('.mode-btn').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.mode === mode);
  });

  qrHint.style.display = mode === 'qr' ? 'block' : 'none';
  shutter.className = mode === 'video' ? 'video-mode' : '';

  if (mode === 'qr') {
    startQRScan();
  } else {
    stopQRScan();
  }
}

// Xử lý Quét QR
function startQRScan() {
  state.qrScanning = true;
  function scan() {
    if (!state.qrScanning) return;
    if (video.readyState === video.HAVE_ENOUGH_DATA) {
      canvas.width = video.videoWidth;
      canvas.height = video.videoHeight;
      ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
      const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
      const code = jsQR(imageData.data, imageData.width, imageData.height, {
        inversionAttempts: "dontInvert",
      });
      if (code && code.data) {
        playBeep(1200, 0.15);
        qrResult.value = code.data;
        qrPopup.classList.add('show');
        state.qrScanning = false;
        return;
      }
    }
    state.qrAnimId = requestAnimationFrame(scan);
  }
  scan();
}

function stopQRScan() {
  state.qrScanning = false;
  if (state.qrAnimId) cancelAnimationFrame(state.qrAnimId);
}

// Chụp ảnh
function takePhoto() {
  if (state.flashOn) {
    fullscreenFlash.style.background = state.flashColor;
    fullscreenFlash.style.opacity = '1';
    setTimeout(() => { fullscreenFlash.style.opacity = '0'; }, 300);
  } else {
    shutterFlash.style.opacity = '0.8';
    setTimeout(() => { shutterFlash.style.opacity = '0'; }, 100);
  }

  playShutterSound();

  const w = video.videoWidth || 1920;
  const h = video.videoHeight || 1080;
  canvas.width = w;
  canvas.height = h;

  ctx.save();
  ctx.filter = video.style.filter;
  ctx.translate(w / 2, h / 2);
  ctx.scale(state.flipH ? -state.zoom : state.zoom, state.flipV ? -state.zoom : state.zoom);
  ctx.translate(-w / 2, -h / 2);
  ctx.drawImage(video, 0, 0, w, h);
  ctx.restore();

  const link = document.createElement('a');
  link.download = `photo_${Date.now()}.png`;
  link.href = canvas.toDataURL('image/png');
  link.click();
  showToast("Đã lưu ảnh!");
}

// Quay Video
function toggleRecording() {
  if (state.isRecording) {
    stopRecording();
  } else {
    startRecording();
  }
}

function startRecording() {
  state.recordedChunks = [];
  const recStream = canvas.captureStream(30);
  
  if (state.stream.getAudioTracks().length > 0) {
    recStream.addTrack(state.stream.getAudioTracks()[0]);
  }

  state.mediaRecorder = new MediaRecorder(recStream, { mimeType: 'video/webm' });
  state.mediaRecorder.ondataavailable = e => {
    if (e.data.size > 0) state.recordedChunks.push(e.data);
  };

  state.mediaRecorder.onstop = () => {
    const blob = new Blob(state.recordedChunks, { type: 'video/webm' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `video_${Date.now()}.webm`;
    a.click();
    showToast("Đã lưu video!");
  };

  state.mediaRecorder.start();
  state.isRecording = true;
  app.classList.add('recording-active');
  shutter.classList.add('recording');
  recTimerEl.style.display = 'block';

  let sec = 0;
  recTimerEl.textContent = '00:00:00';
  state.recTimerInt = setInterval(() => {
    sec++;
    const hrs = String(Math.floor(sec / 3600)).padStart(2, '0');
    const mins = String(Math.floor((sec % 3600) / 60)).padStart(2, '0');
    const secs = String(sec % 60).padStart(2, '0');
    recTimerEl.textContent = `${hrs}:${mins}:${secs}`;
  }, 1000);

  function drawRecordFrame() {
    if (!state.isRecording) return;
    const w = video.videoWidth || 1280;
    const h = video.videoHeight || 720;
    canvas.width = w;
    canvas.height = h;
    ctx.save();
    ctx.filter = video.style.filter;
    ctx.translate(w / 2, h / 2);
    ctx.scale(state.flipH ? -state.zoom : state.zoom, state.flipV ? -state.zoom : state.zoom);
    ctx.translate(-w / 2, -h / 2);
    ctx.drawImage(video, 0, 0, w, h);
    ctx.restore();
    state.recAnimId = requestAnimationFrame(drawRecordFrame);
  }
  drawRecordFrame();
}

function stopRecording() {
  state.isRecording = false;
  state.mediaRecorder.stop();
  clearInterval(state.recTimerInt);
  if (state.recAnimId) cancelAnimationFrame(state.recAnimId);
  app.classList.remove('recording-active');
  shutter.classList.remove('recording');
  recTimerEl.style.display = 'none';
}

// Xử lý nút Shutter (Chụp / Quay)
shutter.addEventListener('click', () => {
  if (state.mode === 'qr') return;
  if (state.mode === 'video') {
    toggleRecording();
    return;
  }
  if (state.timerSec > 0) {
    let count = state.timerSec;
    countdownEl.textContent = count;
    countdownEl.classList.add('show');
    playBeep(600, 0.08);
    const timer = setInterval(() => {
      count--;
      if (count > 0) {
        countdownEl.textContent = count;
        playBeep(600, 0.08);
      } else {
        clearInterval(timer);
        countdownEl.classList.remove('show');
        takePhoto();
      }
    }, 1000);
  } else {
    takePhoto();
  }
});

// Sự kiện UI Controls
document.querySelectorAll('.mode-btn').forEach(btn => {
  btn.addEventListener('click', () => setMode(btn.dataset.mode));
});

flipVBtn.addEventListener('click', () => { state.flipV = !state.flipV; applyVideoTransform(); });
flipHBtn.addEventListener('click', () => { state.flipH = !state.flipH; applyVideoTransform(); });

zoomSlider.addEventListener('input', (e) => {
  state.zoom = parseFloat(e.target.value);
  applyVideoTransform();
});

// Sự kiện Flash & Popup Menus
flashBtn.addEventListener('click', () => {
  state.flashOn = !state.flashOn;
  flashBtn.classList.toggle('active', state.flashOn);
});

colorBtn.addEventListener('click', (e) => {
  e.stopPropagation();
  const show = !colorPalette.classList.contains('show');
  closeAllMenus();
  if (show) {
    placePopup(colorPalette, colorBtn, 'top');
    colorPalette.classList.add('show');
  }
});

document.querySelectorAll('.color-swatch').forEach(sw => {
  sw.addEventListener('click', () => {
    document.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('selected'));
    sw.classList.add('selected');
    state.flashColor = sw.dataset.color;
    colorDot.style.background = state.flashColor;
    closeAllMenus();
  });
});

timerBtn.addEventListener('click', (e) => {
  e.stopPropagation();
  const show = !timerMenu.classList.contains('show');
  closeAllMenus();
  if (show) {
    placePopup(timerMenu, timerBtn, 'center');
    timerMenu.classList.add('show');
  }
});

document.querySelectorAll('.timer-opt').forEach(opt => {
  opt.addEventListener('click', () => {
    document.querySelectorAll('.timer-opt').forEach(o => o.classList.remove('active'));
    opt.classList.add('active');
    state.timerSec = parseInt(opt.dataset.sec, 10);
    timerBtn.classList.toggle('is-modified', state.timerSec > 0);
    closeAllMenus();
  });
});

aspectBtn.addEventListener('click', () => {
  const aspects = ['16:9', '4:3', '1:1'];
  let idx = (aspects.indexOf(state.forceAspect) + 1) % aspects.length;
  state.forceAspect = aspects[idx];
  aspectBtn.textContent = state.forceAspect;
  updateAspectRatio();
});

// Bộ lọc
const filterBtn = document.getElementById('filter-btn');
const filterPanel = document.getElementById('filter-panel');
if (filterBtn && filterPanel) {
  filterBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    const show = !filterPanel.classList.contains('show');
    closeAllMenus();
    if (show) {
      placePopup(filterPanel, filterBtn, 'top');
      filterPanel.classList.add('show');
    }
  });

  document.querySelectorAll('.filter-item').forEach(item => {
    item.addEventListener('click', () => {
      document.querySelectorAll('.filter-item').forEach(i => i.classList.remove('selected'));
      item.classList.add('selected');
      state.filter = item.dataset.filter;
      applyFilters();
      closeAllMenus();
    });
  });
}

// EV / Saturation / Temperature Popups
function setupAdjPopup(btn, popup, slider, key) {
  btn.addEventListener('click', (e) => {
    e.stopPropagation();
    const show = !popup.classList.contains('show');
    closeAllMenus();
    if (show) {
      placePopup(popup, btn, 'center');
      popup.classList.add('show');
    }
  });
  slider.addEventListener('input', (e) => {
    state[key] = parseFloat(e.target.value);
    applyFilters();
  });
}

setupAdjPopup(evBtn, evPopup, evSlider, 'ev');
setupAdjPopup(satBtn, satPopup, satSlider, 'sat');
setupAdjPopup(tempBtn, tempPopup, tempSlider, 'temp');

// Reset Button
document.getElementById('reset-btn').addEventListener('click', () => {
  state.ev = 0; state.sat = 1; state.temp = 0; state.filter = 'none';
  evSlider.value = 0; satSlider.value = 1; tempSlider.value = 0;
  document.querySelectorAll('.filter-item').forEach(i => {
    i.classList.toggle('selected', i.dataset.filter === 'none');
  });
  applyFilters();
  closeAllMenus();
});

// Đóng Popup khi click ngoài hoặc bấm nút X
document.addEventListener('click', (e) => {
  if (e.target.dataset.close) {
    closeAllMenus();
    return;
  }
  if (!e.target.closest('.popup-menu') && 
      !e.target.closest('#color-palette') && 
      !e.target.closest('#filter-panel') && 
      !e.target.closest('#timer-menu') && 
      !e.target.closest('.adj-popup')) {
    closeAllMenus();
  }
});

// QR Popup Actions
document.getElementById('qr-copy').addEventListener('click', () => {
  qrResult.select();
  navigator.clipboard.writeText(qrResult.value);
  showToast("Đã sao chép vào bộ nhớ tạm!");
});

document.getElementById('qr-close').addEventListener('click', () => {
  qrPopup.classList.remove('show');
  if (state.mode === 'qr') startQRScan();
});

// Lắng nghe zoom bằng lăn chuột
stage.addEventListener('wheel', (e) => {
  e.preventDefault();
  let z = state.zoom + (e.deltaY < 0 ? 0.2 : -0.2);
  state.zoom = Math.min(10, Math.max(1, z));
  zoomSlider.value = state.zoom;
  applyVideoTransform();
}, { passive: false });

// Khởi chạy ứng dụng
initCamera();
updateAspectRatio();
</script>
